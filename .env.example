# ============================================================
# AquaFlow Tracker — Environment Configuration (TEMPLATE)
# ============================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` — it is git-ignored.
#
# Supabase: Dashboard -> Project Settings -> API
# ============================================================

# --- Supabase ---
SUPABASE_URL=
# Server-side secret key (bypasses RLS). Used by the Flask backend.
SUPABASE_SECRET_KEY=
# Public/publishable key (optional, only for browser clients)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
# Legacy fallback key name (optional)
SUPABASE_KEY=

# --- Flask ---
# Long random string used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=false
PORT=5000

# --- Accounts ---
# Admin account created automatically on startup (admins cannot self-register).
ADMIN_EMAIL=admin@aquaflow.com
ADMIN_PASSWORD=
# true = seed demo accounts and show the login preset buttons (classroom demos only)
DEMO_MODE=false
