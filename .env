# ============================================================
# AquaFlow Tracker — Environment Configuration
# ============================================================
# HOW TO FILL THIS:
# 1. Go to https://supabase.com → your project → Settings → API
# 2. Copy "Project URL" → paste as SUPABASE_URL
# 3. Copy "anon public" key → paste as SUPABASE_KEY
# 4. Set SECRET_KEY to any random string (for Flask sessions)
# ============================================================

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_KEY=YOUR-ANON-OR-SERVICE-ROLE-KEY
SECRET_KEY=change-this-to-a-random-secret-string
